# JARVIS / WhisperFlow Formatter Configuration
# Pick your provider: "groq", "xai" (Grok), or "ollama"
JARVIS_LLM_PROVIDER=groq

# Groq Cloud API Key (Free, fastest inference at api.groq.com)
GROQ_API_KEY=

# xAI / Grok API Key
XAI_API_KEY=

# Optional local Ollama settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
